# Copy to .env.local for local builds with push notifications enabled.
# Netlify: set the same keys in Site configuration → Environment variables.

# Keep this relative in browser builds. Netlify/Angular proxy it to the API.
PUBLIC_API_BASE_URL=/api

# Generate with: npx web-push generate-vapid-keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:support@drmoghadam.com
